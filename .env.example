# === DATABASE CONFIGURATION ===
# Supabase or any other PostgreSQL provider (e.g. Postgres.app, Docker, Neon)
# If your friend created Supabase, paste the Supabase direct connection string here.
DATABASE_URL=postgres://vvs:vvs_dev_password@127.0.0.1:5433/vvs_dev

# === INFRASTRUCTURE SERVICES ===
REDIS_URL=redis://localhost:6379
JWT_SECRET=super_secret_jwt_key_at_least_16_chars_long

# === APPLICATION SETTINGS ===
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# === THIRD-PARTY INTEGRATIONS ===
PAYSTACK_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=

# === FIREBASE CONFIGURATION (Optional, does not conflict with Supabase) ===
