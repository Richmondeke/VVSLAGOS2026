{
    "compilerOptions": {
        "strict": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "composite": true,
        "outDir": "dist",
        "rootDir": "src",
        "paths": {
            "@vvs/contracts": ["./packages/contracts/src"],
            "@vvs/shared": ["./packages/shared/src"],
            "@vvs/auth": ["./packages/auth/src"],
            "@vvs/members": ["./packages/members/src"],
            "@vvs/marketplace": ["./packages/marketplace/src"],
            "@vvs/finance": ["./packages/finance/src"],
            "@vvs/social": ["./packages/social/src"],
            "@vvs/platform": ["./packages/platform/src"]
        }
    },
    "exclude": ["node_modules", "dist"]
}
